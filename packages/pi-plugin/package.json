{
	"name": "@ufoq/pi-mini-magic-context",
	"version": "0.1.0",
	"type": "module",
	"description": "Pi coding agent extension for Mini Magic Context — historian-backed context management and journal search",
	"main": "dist/index.js",
	"license": "MIT",
	"author": "ualtinok",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"extension",
		"context",
		"magic-context",
		"ai",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ufoq/mini-magic-context",
		"directory": "packages/pi-plugin"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
        "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --format esm --splitting --external @earendil-works/pi-coding-agent --external @earendil-works/pi-tui --external @huggingface/transformers --external node:sqlite",
		"typecheck": "tsc --noEmit",
		"test": "bun scripts/test-mini.ts",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"format": "biome format --write src",
		"format:check": "biome format src",
		"clean": "rm -rf dist",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.1.0",
		"comment-json": "^5.0.0",
		"typebox": "^1.3.1",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@earendil-works/pi-coding-agent": "^0.80.2",
		"@earendil-works/pi-tui": "^0.80.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/bun": "^1.3.10",
		"@types/node": "^22.20.0",
		"typescript": "^5.8.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^0.80.2",
		"@earendil-works/pi-tui": "^0.80.2"
	},
	"exports": {
		".": {
			"import": "./dist/index.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}
