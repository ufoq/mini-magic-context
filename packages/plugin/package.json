{
  "name": "@ufoq/mini-magic-context-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared core for Mini Magic Context \u2014 historian-backed context management, tagging, and search",
  "author": "ualtinok",
  "license": "MIT",
  "keywords": [
    "context",
    "ai",
    "llm",
    "prompt-caching",
    "session-history"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ufoq/mini-magic-context",
    "directory": "packages/plugin"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "bun scripts/test-mini.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "ai-tokenizer": "^1.0.6",
    "comment-json": "^5.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.20.0",
    "bun-types": "^1.3.10",
    "typescript": "^5.8.0"
  },
  "private": true
}
