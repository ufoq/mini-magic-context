{
  "name": "@ufoq/opencode-mini-magic-context",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin for Mini Magic Context — historian-backed context management and journal search",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "ualtinok",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "context",
    "ai",
    "llm",
    "prompt-caching",
    "session-history"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ufoq/mini-magic-context",
    "directory": "packages/plugin"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --format esm --splitting --external @opencode-ai/plugin --external @huggingface/transformers --external onnxruntime-web --external bun:sqlite --external node:sqlite && tsc --emitDeclarationOnly && bun scripts/prune-declarations.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "bun scripts/test-mini.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@opencode-ai/plugin": "^1.17.11",
    "@opencode-ai/sdk": "^1.17.11",
    "ai-tokenizer": "^1.0.6",
    "comment-json": "^5.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.20.0",
    "bun-types": "^1.3.10",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "oc-plugin": [
    "server"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.0"
  }
}
